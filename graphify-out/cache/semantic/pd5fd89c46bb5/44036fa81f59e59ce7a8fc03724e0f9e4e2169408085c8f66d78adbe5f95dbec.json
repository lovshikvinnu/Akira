{"nodes": [{"id": "docs_recovery_phase_b_event_architecture_reconciliation_phasebreconciliation", "label": "Phase B \u2014 Event Architecture Reconciliation", "file_type": "document", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_legacyeventbus", "label": "Legacy Event Bus (SimpleEventBus)", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/shared/infrastructure/event-bus/index.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "String-topic pub/sub with a '*' wildcard channel. Carries only presence.updated in practice; its 12 runtime publishers never fire because no module is ever loaded."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_instrumentationeventbus", "label": "Instrumentation Event Bus (globalEventBus)", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/instrumentation/event-bus.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed AkiraEvent delivery to EventSubscriber objects with no wildcard subscription \u2014 the asymmetry that forces any GENESIS consumer to be a concrete, filtering adapter."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_akiraevent", "label": "AkiraEvent Envelope", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_memoryevent", "label": "MemoryEvent", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/genesis/events/event-service.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GENESIS's own event vocabulary, kept distinct from AkiraEvent because the two model genuinely different things: a fact of the platform versus an item of cognition."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_publisher", "label": "Instrumentation Publisher and Client-Server Split", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/instrumentation/publisher.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "26 production call sites / 25 distinct types, every one a string literal; the Events registry is imported by akira-store and never used."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_eventstore", "label": "Event Store", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/instrumentation/event-store/", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Durable append-only log of AkiraEvent; findBetween is the only replay primitive in AKIRA. Only latest() has a rowid tiebreaker, so the other four reads order by millisecond timestamp alone against a 12k-22k events/sec benchmark."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_persistencesubscriber", "label": "PersistenceSubscriber", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_timelinesubscriber", "label": "TimelineSubscriber", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/instrumentation/subscribers/timeline-subscriber.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard-coded 22-type allowlist writing timeline_events keyed on AkiraEvent.id \u2014 an accidental idempotency. Four published types are missing from the allowlist and one allowlist entry is never published."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_analyticssubscriber", "label": "AnalyticsSubscriber (never registered)", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_middlewarepipeline", "label": "Event Middleware Pipeline", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/instrumentation/middleware/index.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarded by if(!event.x) so re-running is idempotent for id/timestamp/correlationId \u2014 which matters because the pipeline runs twice, once on the client and again on the server."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_serializationvalidator", "label": "serializationValidator", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throws on any undefined nested value, Map, Set, NaN or class instance \u2014 and on the client it throws inside akira-store.set()'s updater (audit REL-006)."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_genesiseventservice", "label": "GENESIS MemoryEvent Stream (eventService)", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/genesis/events/event-service.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only intake for the cognitive pipeline. Fed by 77 internal record() calls plus the legacy-bus wildcard; saveMemory persists to akira-store RAM only, with no memories table, and publishes even after a persist failure (audit REL-005)."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_candidateruleengine", "label": "Candidate Rule Engine", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/genesis/candidate/candidate-rules.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches exactly 7 legacy names; presence_updated \u2014 the one type that reaches GENESIS from the platform \u2014 matches no rule, so it produces nothing. registerRule() is exported with zero call sites."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_localemittermesh", "label": "Nine Local GENESIS Subsystem Emitters", "file_type": "concept", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent Set<Callback> emitters fanning six engines into contextResolutionService and then into initiativeService. This mesh is the one part of the event architecture that works end to end; its only defect is that its ultimate input is starved."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_legacybridge", "label": "Legacy-to-Instrumentation Bridge", "file_type": "code", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "src/shared/infrastructure/event-bus/index.ts:61-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-way legacy to instrumentation with two layers of total error suppression, and it excludes presence.updated \u2014 the only type that travels on the legacy bus \u2014 so it forwards nothing and points away from GENESIS anyway."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_threeseverancepoints", "label": "The Three Severance Points", "file_type": "concept", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong bus, wrong constant, wrong name \u2014 three independent faults each blocking the flow on their own, so fixing any one alone changes nothing."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_neverexercised", "label": "The Pipeline Has Never Been Exercised", "file_type": "rationale", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The live DB holds 3 projects, 7 tasks, 3 notes and 3 sessions from Jun-Jul 2026, one events row (a 'tasks-test' fixture) and zero timeline_events. Instrumentation was introduced 2026-07-24, after all that data. The pipeline is not failing in production; it has never run there."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_recursionrisk", "label": "Event Recursion Loop Risk", "file_type": "rationale", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The record -> saveMemory -> akira.set -> presence -> publish loop is not theoretical: git commit 67b89fd proves it happened once already."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_orphanconstants", "label": "Event Contract Drift and Orphan Constants", "file_type": "concept", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "72 of 93 declared event constants are never published, 6 published types are undeclared, and 1 is consumed but never published."}, {"id": "docs_recovery_phase_b_event_architecture_reconciliation_migrationphases", "label": "Five-Phase Event Migration Proposal", "file_type": "concept", "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stabilise the contract, introduce the adapter dormant, dual-run verification, cut the cognitive path over, retire the legacy architecture \u2014 cutover gated behind measurement because this path has never carried real traffic."}], "edges": [{"source": "docs_recovery_phase_b_event_architecture_reconciliation_phasebreconciliation", "target": "docs_recovery_phase_b_event_architecture_reconciliation_threeseverancepoints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "\u00a72.3", "weight": 1}, {"source": "docs_recovery_phase_b_event_architecture_reconciliation_phasebreconciliation", "target": "docs_recovery_phase_b_event_architecture_reconciliation_neverexercised", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "\u00a74.8", "weight": 1}, {"source": "docs_recovery_phase_b_event_architecture_reconciliation_phasebreconciliation", "target": "docs_recovery_phase_b_event_architecture_reconciliation_migrationphases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/phase-b-event-architecture-reconciliation.md", "source_location": "\u00a710", "weight": 1}, {"source": "docs_recovery_phase_b_e