{"nodes": [{"id": "docs_recovery_event_pipeline_remediation_design_eventpipelineremediationdesign", "label": "Event Pipeline Remediation Design", "file_type": "document", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": "2026-09-03", "author": null, "contributor": null}, {"id": "docs_recovery_event_pipeline_remediation_design_s1_wrong_bus", "label": "Severance S1 \u2014 Wrong Bus", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workspace events publish to the instrumentation bus while GENESIS subscribes to the legacy bus; each severance blocks the flow alone, so repairing any subset changes nothing observable."}, {"id": "docs_recovery_event_pipeline_remediation_design_s2_task_completed_constant", "label": "Severance S2 \u2014 TASK_COMPLETED Constant Collision", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": "contracts/events.ts:76-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events.TASK_COMPLETED is declared twice; the later declaration wins at runtime and resolves to planning.task.completed, so the published task.completed never matches."}, {"id": "docs_recovery_event_pipeline_remediation_design_s3_note_name_drift", "label": "Severance S3 \u2014 note.updated vs note.edited Drift", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": "akira-store.ts:469", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The publisher emits note.updated while the registry, Timeline allowlist and GENESIS all expect note.edited, making note edits invisible to every consumer."}, {"id": "docs_recovery_event_pipeline_remediation_design_s4_dead_builder_barrels", "label": "Severance S4 \u2014 Dead Story and Importance Builders", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": "genesis/stories/index.ts, genesis/importance/index.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory to Story and Memory to Importance are dead because the builders that subscribe them live in barrels the production graph never imports; reconnecting the buses is necessary but not sufficient."}, {"id": "docs_recovery_event_pipeline_remediation_design_realityadapter", "label": "RealityAdapter", "file_type": "code", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": "src/genesis/events/reality-adapter.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names a translation that already exists unnamed inside event-service.ts:94-160. Deliberately NOT called EventAdapter and not placed under compatibility/adapters/, because two differently-purposed files named 'event adapter' is the ambiguity that produced the defect."}, {"id": "docs_recovery_event_pipeline_remediation_design_realityadaptermetrics", "label": "RealityAdapterMetrics", "file_type": "code", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapter failures are counted and inspectable rather than console.error-and-continue, so a GENESIS fault cannot silently break the platform."}, {"id": "docs_recovery_event_pipeline_remediation_design_optiona", "label": "Option A \u2014 Unify on the Instrumentation Bus", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: couples GENESIS to the platform envelope and every platform event type, and because the bus has no wildcard an adapter appears anyway \u2014 just unnamed and untested. Increases recursion risk."}, {"id": "docs_recovery_event_pipeline_remediation_design_optionb", "label": "Option B \u2014 Platform Bus plus GENESIS Reality Adapter", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended. Preserves GENESIS independence and provides replay; mirrors the proven WorkspaceProvider seam; keeps MemoryEvent as GENESIS's own vocabulary; and is a strict subset of Option D, so choosing it now does not foreclose the long-term shape."}, {"id": "docs_recovery_event_pipeline_remediation_design_optionc", "label": "Option C \u2014 Reverse Bridge Between Both Buses", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: creates a cycle between two buses with infinite-forwarding hazards; git commit 67b89fd proves the recursion already happened once. This is the shape that produced the current defect."}, {"id": "docs_recovery_event_pipeline_remediation_design_optiond", "label": "Option D \u2014 Event-Store-First Cognition", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right long-term shape \u2014 perfect replay symmetry, divergence impossible by construction \u2014 but needs a change feed and durable cursor that do not exist, and adds persistence round-trip latency to cognition."}, {"id": "docs_recovery_event_pipeline_remediation_design_reachability_test_class", "label": "Reachability Test Class", "file_type": "concept", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory and new: a test class that proves subscribers are actually reachable from the production import graph, which is what stops the S4 defect category recurring."}, {"id": "docs_recovery_event_pipeline_remediation_design_idempotency_by_event_id", "label": "Idempotency Keyed on AkiraEvent.id", "file_type": "concept", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes replay safe to re-run and shadow-mode safe to enable; the middleware already guarantees the id and timeline_events already relies on it."}, {"id": "docs_recovery_event_pipeline_remediation_design_loop_prevention", "label": "Loop Prevention and Bus Depth Guard", "file_type": "concept", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "saveMemory()'s write into akira-store is a non-durable duplicate of the Event Store and one leg of the documented recursion loop; flow must be strictly one-way with GENESIS never publishing to the platform bus."}, {"id": "docs_recovery_event_pipeline_remediation_design_initializegenesis", "label": "initializeGenesis Explicit Registration", "file_type": "concept", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred S4 repair: a single explicit entry point that registers every subscriber deliberately, removing reliance on import side effects and creating the seam to remove it for the other eight emitters later."}, {"id": "docs_recovery_event_pipeline_remediation_design_contract_first_ordering", "label": "Contract-First Ordering Constraint", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "events.type stores raw event strings and the live table holds 1 test row and 0 timeline rows, so renaming is free today and expensive the moment real events flow \u2014 the contract must be fixed before the buses are connected."}, {"id": "docs_recovery_event_pipeline_remediation_design_connection_not_cognition_defect", "label": "Connection Defect, Not Cognition Defect", "file_type": "rationale", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One well-formed task_completed event produced 1 candidate, 1 validated memory and 2 understandings with no code changes, proving everything downstream of eventService.record() that is wired works on the first try. This bounds the effort sharply."}, {"id": "docs_recovery_event_pipeline_remediation_design_compatibility_event_adapter", "label": "compatibility/adapters/event-adapter.ts", "file_type": "code", "source_file": "docs/recovery/event-pipeline-remediation-design.md", "source_location": "src/compatibility/adapters/event-adapter.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin SDK/module wrapper delegating publish/subscribe to RuntimeAdapter.events \u2014 explicitly NOT the GENESIS boundary, disambiguated to prevent a naming collision with RealityAdapter."}], "edges": [{"source": "docs_recovery_event_pipeline_remediation_design_eventpipelineremediationdesign", "target": "docs_recovery_phase_b_event_architecture_reconciliation_phasebreconciliation", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recove