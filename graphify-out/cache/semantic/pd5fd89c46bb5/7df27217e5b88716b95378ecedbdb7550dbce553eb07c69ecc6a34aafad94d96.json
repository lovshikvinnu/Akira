{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_engine", "label": "ADR-009: Dedicated Knowledge Subsystem", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected ad-hoc reconstruction of skill dependencies from flat memory logs (severe latency as logs grow) and in-prompt competency inference (inconsistent behavior \u2014 alternating between explaining basics and assuming mastery \u2014 plus prompt inflation). Status: Proposed."}, {"id": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_context", "label": "Knowledge Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Rationale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured competency model that keeps explanations matched to the user's level and stays compact as memory grows; preserves originating subsystem, supporting evidence and confidence rating (Provenance Preservation)."}, {"id": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_evidence_verification", "label": "Evidence Verification (user correction as evidence)", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Rationale \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit user correction of an inferred level is treated as verified evidence and prioritized in future reasoning, while previous inferences are kept so the change stays explainable rather than silently overwritten."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_engine", "target": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_context", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_context", "target": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_provenance_preservation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Rationale \u00a72", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_engine", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_archived_reflection_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Rationale \u00a74 and Consequences (loads archived Reflection Contexts)", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_evidence_verification", "target": "docs_genesis_architecture_decisions_adr_009_knowledge_engine_knowledge_context", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-009-knowledge-engine.md", "source_location": "Rationale \u00a75", "weight": 1.0}], "hyperedges": []}