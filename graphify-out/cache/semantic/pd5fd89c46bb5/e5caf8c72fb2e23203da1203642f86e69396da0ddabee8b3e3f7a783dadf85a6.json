{"nodes": [{"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_engine", "label": "Reflection Engine", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a71 Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrospective progress synthesis is kept out of the active dialogue path so growth analysis never interrupts conversation; it synthesizes trends from facts Memory already stores rather than creating new facts."}, {"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_context", "label": "Reflection Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a75 Reflection Context", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single conceptual output carrying progress, growth, patterns, achievements, challenges, supporting evidence, confidence and time period, so downstream engines read one compact model instead of parsing raw tables."}, {"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_archived_reflection_context", "label": "Archived Reflection Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a74 Reflection Lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutability of the archived record is what makes it safe for Knowledge, Habit and Goal engines to consume at next boot without reading a reflection still being generated."}, {"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_temporal_decoupling", "label": "Temporal Decoupling of Reflection", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a71 Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reflection consumes finalized active contexts at session end and downstream engines may only read previously archived reflections at their next initialization. This prevents circular dependencies between Reflection and the engines that feed it."}, {"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_confidence", "label": "Reflection Confidence", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a72 Responsibilities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Certainty metric over the strength of supporting evidence; low-confidence reflections are hidden rather than shown, prioritizing accuracy over speculation."}, {"id": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_preserve_uncertainty", "label": "Preserve Uncertainty", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a711 Architectural Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer producing no reflection at all over a speculative or misleading summary; uncertainty is propagated rather than rounded away."}], "edges": [{"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_engine", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_context", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a77 Outputs", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_context", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_archived_reflection_context", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a74 Reflection Lifecycle", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_temporal_decoupling", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a71 Purpose", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_context", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_confidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a75 Reflection Context", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_preserve_uncertainty", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_confidence", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/07-reflection-engine.md", "source_location": "\u00a710-11", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_engine", "target": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_provenance_preservation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 