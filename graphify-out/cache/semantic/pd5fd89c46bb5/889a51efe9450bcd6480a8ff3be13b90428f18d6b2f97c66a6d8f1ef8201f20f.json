{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_003_emergent_identity_emergent_identity", "label": "ADR-003: Emergent Identity Discovery", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-003-emergent-identity.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static configuration forms capture self-declared aspirations rather than observed behavior and require ongoing manual curation. Status: Accepted."}, {"id": "docs_genesis_architecture_decisions_adr_003_emergent_identity_identity_layer", "label": "Identity Layer", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-003-emergent-identity.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never manually configured; traits, work styles, values and strengths emerge from long-term patterns across Events, Memories, Stories and physical behavior, and may strengthen, weaken or evolve as focus changes."}, {"id": "docs_genesis_architecture_decisions_adr_003_emergent_identity_traceable_lineage", "label": "Traceable Lineage (Provenance)", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/decisions/ADR-003-emergent-identity.md", "source_location": "Reasoning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because identity is inferred rather than declared, every trait must carry a confidence rating and explicit references to the supporting memories, so it can be inspected or corrected \u2014 this is what makes an inferred profile trustworthy."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_003_emergent_identity_emergent_identity", "target": "docs_genesis_architecture_decisions_adr_003_emergent_identity_identity_layer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/