{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_008_goal_engine_goal_engine", "label": "ADR-008: Dedicated Goal Subsystem", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-008-goal-engine.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected embedding goals in Memory (historical and immutable vs. future-oriented and hierarchical), in Identity (traits evolve slowly, goals change often), and in Projects (goals cross project boundaries or exist with no workspace at all). Division of time: Memory stores the past, State the present, Goals the future path, Identity the character. Status: Proposed."}, {"id": "docs_genesis_architecture_decisions_adr_008_goal_engine_goal_context", "label": "Goal Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-008-goal-engine.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single interface other systems use, so downstream engines never query project or memory tables to find goals."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_008_goal_engine_goal_engine", "target": "docs_genesis_architecture_decisions_adr_008_goal_engine_goal_context", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-008-goal-engine.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_008_goal_engine_goal_context", "target": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_context_builder", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-008-goal-engine.md", "source_location": "Rationale \u00a73 (Context Builder can inject priority goals)", "weight": 1.0},