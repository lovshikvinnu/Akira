{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_014_initiative_engine_silence_by_default", "label": "ADR-014: Dedicated Initiative Subsystem and Silence-by-Default Design", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-014-initiative-engine.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected per-engine self-initiated alerts (simultaneous interventions cause prompt fatigue) and LLM-decided proactivity (conversational models are trained to keep users talking, making silence impossible to guarantee or explain, and inflating token cost). A deterministic engine defaulting to No Action makes every intervention traceable. Status: Proposed."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_014_initiative_engine_silence_by_default", "target": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-014-initiative-engine.md", "source_location": "Decision", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_014_initiative_engine_silence_by_default", "target": "docs_genesis_architecture_decisions_adr_005_companion_philosophy_companion_core_philosophy", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-014-initiative-engine.md", "source_location": "Rationale \u00a71 (cites 01-companion-philosophy.md)", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_014_initiative_engine_silence_by_default", "target": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_resolved_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-014-initiative-engine.md