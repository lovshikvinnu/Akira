{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_memory_ai_separation", "label": "ADR-001: Separation of Memory and AI Models", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coupling memory storage to a specific LLM API limits portability, compromises local-first privacy, and exposes the system to provider lock-in and breaking changes. A unidirectional pipeline keeps the persistent schema unaffected by provider switches or inference failures. Status: Accepted."}, {"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_adaptive_memory_engine", "label": "Adaptive Memory Engine", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent storage layer that must never communicate directly with AI models; standardizing on local primitive schemas lets data be encrypted or managed locally before any reasoning client touches it."}, {"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_recall_engine", "label": "Recall Engine", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relevance selector; together with the Memory Engine it is solely responsible for selecting and delivering primitive candidate models."}, {"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_context_builder", "label": "Context Builder (understanding assembler)", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required intermediate stage that formats logical data before any API payload is built."}, {"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_ai_context_engine", "label": "AI Context Engine (API/prompt translator)", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sole place where provider-specific prompt structure exists, so switching between local ONNX models and cloud APIs touches only this layer."}, {"id": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_reasoning_model", "label": "Reasoning Model (stateless inference core)", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statelessness is deliberate: reasoning holds no memory, so all durable state stays in the local database."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_adaptive_memory_engine", "target": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_recall_engine", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-001-memory-and-ai-separation.md", "source_location": "Decision (pipeline)", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_recall_engine", "target": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_context_builder", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou