{"nodes": [{"id": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsinvestigation", "label": "Stage 1B \u2014 Diagnostics Subsystem Investigation", "file_type": "document", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 7 remaining errors are not damage but the visible edge of an abandoned draft: src/diagnostics/ was created 2026-07-24 and superseded one day later by src/observability/, whose ADR-021 scope explicitly covers Diagnostics, Health and Resource Monitoring."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_a_runtime_diagnostics", "label": "Subsystem A \u2014 Runtime Diagnostics (src/diagnostics/)", "file_type": "code", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "src/diagnostics/", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four files referencing 11 modules, 6 of which were never written in any commit. Zero importers, zero tests, documented nowhere. Classified STALE (primary) plus PARTIALLY IMPLEMENTED (secondary)."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_b_observability_diagnostics", "label": "Subsystem B \u2014 Observability Diagnostics", "file_type": "code", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "src/observability/diagnostics/", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiles and is documented by ADR-021 and 11 architecture docs, but has zero external consumers repo-wide and 7 of its 17 documented packages do not exist \u2014 including exactly the three that would replace the abandoned draft."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_c_analytics_diagnostics", "label": "Subsystem C \u2014 Analytics Diagnostics", "file_type": "code", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "src/analytics/validation/diagnostics.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only one with a live consumer, but its sole test is a hand-rolled script contributing 0 assertions under vitest \u2014 complete and connected, yet unverified."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsservice_collision", "label": "DiagnosticsService Name Collision", "file_type": "concept", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subsystems B and C both export a class named DiagnosticsService with no shared interface \u2014 three unrelated implementations, not layers of one design."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_stale_reference_classification", "label": "Stale Reference vs Incomplete Implementation Classification", "file_type": "concept", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors 1-6 are class D (stale reference to modules that never existed in any object or stash); error 7 is class C (DiagnosticError used as a value against a type-only declaration)."}, {"id": "docs_recovery_stage_1b_diagnostics_investigation_escalation_over_deletion", "label": "Escalate Rather Than Delete", "file_type": "rationale", "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting src/diagnostics/ would make tsc green while leaving AKIRA with no working diagnostics capability at all, so the stage escalates one architecture decision with three options instead of taking the green-build shortcut."}], "edges": [{"source": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsinvestigation", "target": "docs_recovery_stage_1b_diagnostics_baseline_diagnosticsbaseline", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "Baseline link", "weight": 1}, {"source": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsinvestigation", "target": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_a_runtime_diagnostics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "\u00a73.1", "weight": 1}, {"source": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsinvestigation", "target": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_b_observability_diagnostics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "\u00a73.1", "weight": 1}, {"source": "docs_recovery_stage_1b_diagnostics_investigation_diagnosticsinvestigation", "target": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_c_analytics_diagnostics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "\u00a73.1", "weight": 1}, {"source": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_b_observability_diagnostics", "target": "docs_recovery_stage_1b_diagnostics_investigation_subsystem_a_runtime_diagnostics", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1b-diagnostics-investigation.md", "source_location": "superseded one day after creation", "weight": 1}, {"source": "docs_recovery_stage_1b_diagnostics_investigation_