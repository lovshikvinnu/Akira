{"nodes": [{"id": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_engine", "label": "Initiative Engine", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a71 Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separating initiative from response generation means proactivity is judged objectively before any text is written. Consumes only the Resolved Context; consuming individual subsystem outputs directly is prohibited."}, {"id": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_decision", "label": "Initiative Decision", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a75 Initiative Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures outcome (Silence, Suggestion, Question, Reminder), confidence, supporting evidence, user benefit, timing suitability and why silence was overridden \u2014 making every intervention auditable."}, {"id": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_silence_is_the_default", "label": "Silence is the Default", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a79 Initiative Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engagement-maximizing notification loops create fatigue and erode trust, so no action is the default state; weak evidence, low confidence, ambiguity, conflicting priorities or deep-focus timing all fall back to silence."}, {"id": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_user_autonomy", "label": "User Autonomy Protection", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a79 Initiative Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The companion never insists, demands, coerces or overrides user choices, and never creates artificial urgency through alerts or countdowns."}, {"id": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_conversation_lifecycle", "label": "Conversation Lifecycle", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a78 Integration Points", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receives Initiative Decisions and executes dialogue actions; it decides how to communicate while the Initiative Engine decides if communication is appropriate."}], "edges": [{"source": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_engine", "target": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_resolved_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a76 Inputs (cites 08-context-resolution-engine.md)", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_engine", "target": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_initiative_decision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/companion-intelligence/09-initiative-engine.md", "source_location": "\u00a77 Outputs", "weight": 1.0}, {"source": "docs_genesis_architecture_companion_intelligence_09_initiative_engine_silence_is_the_default", "target": "docs_genesis_architecture_companion_intelligence_09_initiative_