{"nodes": [{"id": "docs_recovery_stage_1c_test_database_safety_testdatabasesafety", "label": "Stage 1C Part B \u2014 Test Database Safety", "file_type": "document", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": null, "source_url": null, "captured_at": "2026-09-03", "author": null, "contributor": null, "rationale": "Objective: guarantee that no test or validation command can silently write to the user's persistent AKIRA database."}, {"id": "docs_recovery_stage_1c_test_database_safety_getdatabasepath", "label": "getDatabasePath", "file_type": "code", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": "src/persistence/connection.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_stage_1c_test_database_safety_esm_hoisting_root_cause", "label": "ESM Import Hoisting Root Cause", "file_type": "rationale", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In ESM every import declaration is hoisted and its module graph fully evaluated before any statement in the importing module's body runs, so a test assigning AKIRA_DATABASE_PATH on line 1 runs after module-scope singletons have already cached a production handle. The per-file protection pattern is structurally incapable of working."}, {"id": "docs_recovery_stage_1c_test_database_safety_memory_default", "label": "In-Memory Database Default Under Test", "file_type": "rationale", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over a temp file because it cannot leak to disk, needs no cleanup, and makes the safe default unconditional rather than dependent on each test remembering to opt in. Environment signals were verified rather than assumed, and explicit overrides plus production runtime behaviour are unchanged."}, {"id": "docs_recovery_stage_1c_test_database_safety_databasepathsafetytest", "label": "tests/database-path-safety.test.ts", "file_type": "code", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": "tests/database-path-safety.test.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten regression tests across isolation, explicit override and production preservation, so the fix cannot silently regress the way the old per-file pattern did."}, {"id": "docs_recovery_stage_1c_test_database_safety_resolver_bypass", "label": "check_real_db.ts Resolver Bypass", "file_type": "code", "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": "src/persistence/check_real_db.ts:4-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens the production database directly, bypassing the resolver \u2014 but with zero importers and no npm script it is not part of the command surface, so it was recorded rather than changed."}], "edges": [{"source": "docs_recovery_stage_1c_test_database_safety_esm_hoisting_root_cause", "target": "docs_recovery_stage_1c_test_database_safety_getdatabasepath", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": "\u00a72.3", "weight": 1}, {"source": "docs_recovery_stage_1c_test_database_safety_memory_default", "target": "docs_recovery_stage_1c_test_database_safety_getdatabasepath", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/stage-1c-test-database-safety.md", "source_location": "\u00a74.3, \u00a74.4", "weight": 1}, {"source": "docs_recovery_stage_1c_test_database_safety_databasepathsafetytest", "target": "docs_recovery_stage_1c_test_database_safety_getdataba