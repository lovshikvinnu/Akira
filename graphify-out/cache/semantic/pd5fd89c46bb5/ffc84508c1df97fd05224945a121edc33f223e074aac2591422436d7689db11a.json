{"nodes": [{"id": "docs_genesis_architecture_decisions_readme_adr_process", "label": "AKIRA ADR Process", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/README.md", "source_location": "Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specifications describe what was built and how; ADRs preserve the contextual trade-offs and debates so future contributors and AI agents understand why. Standard sections: Status, Context, Decision, Reasoning, Consequences. ADRs record why, not how \u2014 no schemas, API specs, coding patterns or UI designs."}, {"id": "docs_genesis_architecture_decisions_readme_immutable_history", "label": "Immutable ADR History", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/decisions/README.md", "source_location": "Guidelines for Contributors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An accepted ADR is never edited to change a historical decision; a reversal gets a new ADR that supersedes it, with the original marked Superceded and linked. Specifications evolve toward a current target state, ADRs stay a chronological log \u2014 keeping the two separate preserves full traceability."}], "edges": [{"source": "docs_genesis_architecture_decisions_readme_adr_process", "target": "docs_genesis_architecture_decisions_readme_immutable_history", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/README.md", "source_location": "Guidelines for Contributors", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_readme_adr_process", "target": "docs_genesis_architecture_decisions_adr_001_memory_and_ai_separation_memory_ai_separation", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/README.md", "source_location": "Index of Decisions", "weight": 1.0},