{"nodes": [{"id": "docs_shared_architecture_architecture_akiraarchitectureconstitution", "label": "AKIRA Architecture Constitution", "file_type": "document", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_shared_architecture_architecture_akiraos", "label": "AKIRA OS Pillar (Reality)", "file_type": "concept", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers 'what exists in the user's world?' \u2014 owns projects, tasks, notes, sessions, file metadata, search index and the persistence layers. Only AKIRA OS updates core workspace data."}, {"id": "docs_shared_architecture_architecture_genesis", "label": "GENESIS Pillar (Interpretation)", "file_type": "concept", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers 'what does it all mean?' \u2014 owns memory consolidation, validation, narrative arcs, user profiling and AI provider calls. Only GENESIS interprets."}, {"id": "docs_shared_architecture_architecture_eventdrivenarchitecture", "label": "Event-Driven Architecture Principle", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AKIRA OS emits domain events on a generic eventBus and GENESIS subscribes asynchronously, so the interpretation pillar can build cognitive graphs without the reality pillar knowing it exists."}, {"id": "docs_shared_architecture_architecture_repositoryprinciple", "label": "Every Persistent Read or Write Flows Through a Repository", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct SQL, direct SQLite client imports and storage access outside the persistence layer are prohibited, so data access has exactly one auditable seam."}, {"id": "docs_shared_architecture_architecture_publicapiprinciple", "label": "Subsystems Expose Only Public APIs", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All cross-directory communication goes through src/akira-os/index.ts and src/genesis/index.ts with no deep internal imports, keeping implementation details hidden and preventing circular dependencies."}, {"id": "docs_shared_architecture_architecture_llmfinalconsumer", "label": "LLM Is the Final Consumer", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The AI model reads context and interprets meaning but is never the primary source of truth or the owner of persistent workspace state."}, {"id": "docs_shared_architecture_architecture_nativedependencyconstraint", "label": "Native Dependency Constraint", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "better-sqlite3 is an intentional native C++ dependency, so serverless and edge runtimes such as Cloudflare Workers are unsupported; the backend must run on a persistent Node/Bun runtime."}, {"id": "docs_shared_architecture_architecture_desktopfirst", "label": "Desktop-First Architecture", "file_type": "rationale", "source_file": "docs/shared/architecture/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A local SQLite engine is used to maintain user privacy, low latency and offline capability."}], "edges": [{"source": "docs_shared_architecture_architecture_akiraarchitectureconstitution", "target": "docs_shared_architecture_architecture_akiraos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/architecture/architecture.md", "source_location": "The Two Pillars", "weight": 1}, {"source": "docs_shared_architecture_architecture_akiraarchitectureconstitution", "target": "docs_shared_architecture_architecture_genesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/architecture/architecture.md", "source_location": "The Two Pillars", "weight": 1}, {"source": "docs_shared_architecture_architecture_akiraos", "target": "docs_shared_architecture_architecture_genesis", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/architecture/architecture.md", "source_location": "Core Principle 6", "weight": 1}, {"source": "docs_shared_architecture_architecture_eventdrivenarchitecture", "target": "docs_shared_architecture_architecture_akiraos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/architecture/architecture.md", "source_location": "Core Principle 6", "weight": 1}, {"source": "docs_shared_architecture_architecture_akiraarchitectureconstitution", "target": "docs_shared_architecture_architecture_repositoryprinciple", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/architecture/architecture.md", "source_location": "Core Principle 11", "weight": 1}, {"source": "docs_shared_architecture_architecture_akiraarchitectureconstitution", "target": "docs_shared_architecture_architecture_publicapiprinciple", "relation": "references", "confidence": "EXTRACTED",