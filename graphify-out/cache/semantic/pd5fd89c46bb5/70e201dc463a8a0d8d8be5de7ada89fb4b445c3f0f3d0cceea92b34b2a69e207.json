{"nodes": [{"id": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "label": "Data Protection Philosophy", "file_type": "document", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security is treated as a fundamental design principle shaping every architectural layer, not a post-implementation feature, because the data AKIRA collects is deeply intimate."}, {"id": "docs_shared_security_01_data_protection_philosophy_memoriessensitive", "label": "Memories Are Highly Sensitive", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cognitive database stores thoughts, reflections, workspace actions and emerging identity characteristics \u2014 the user's private mental space \u2014 so all stored memories carry the highest sensitivity classification."}, {"id": "docs_shared_security_01_data_protection_philosophy_growthdata", "label": "Growth Data Deserves Strong Protection", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unauthorized access to failures, habits, values and emotional states could enable psychological manipulation, so the companion core must actively resist third-party observation and OS-level scraping."}, {"id": "docs_shared_security_01_data_protection_philosophy_platformappropriate", "label": "Platform-Appropriate Protection", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementations must leverage the OS's secure credential storage and native file-access controls so other local applications or scripts cannot read the user databases."}, {"id": "docs_shared_security_01_data_protection_philosophy_activeidleprotection", "label": "Active and Idle Protection", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At rest, files and logs use native encryption; in use, temporary context packages, in-memory caches and chat contexts must be scrubbed when no longer required to avoid memory leakage."}, {"id": "docs_shared_security_01_data_protection_philosophy_privacyownership", "label": "Preservation of Privacy and Ownership", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user owns their data: the security model must preserve absolute privacy without restricting backup, export, migration or deletion, and encryption keys and data paths stay under the user's control."}, {"id": "docs_shared_security_01_data_protection_philosophy_zerothirdpartytrust", "label": "Zero Third-Party Trust", "file_type": "rationale", "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregation, memory recall and identity synthesis all occur locally; no raw telemetry or personal identifiers leave the device, and only anonymized filtered context packages may cross a network boundary."}], "edges": [{"source": "docs_shared_architecture_architecture_llmfinalconsumer", "target": "docs_shared_security_01_data_protection_philosophy_zerothirdpartytrust", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_memoriessensitive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_growthdata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_platformappropriate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_activeidleprotection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_privacyownership", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_dataprotectionphilosophy", "target": "docs_shared_security_01_data_protection_philosophy_zerothirdpartytrust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_memoriessensitive", "target": "docs_shared_architecture_architecture_genesis", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": null, "weight": 1}, {"source": "docs_shared_security_01_data_protection_philosophy_activeidleprotection", "target": "docs_shared_sprint_report_contextbuilder", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/shared/security/01-data-protection-philosophy.md", "source_location": "temporary context packages scrubbed from memory", "weight": 1}], "hyperedges": []}