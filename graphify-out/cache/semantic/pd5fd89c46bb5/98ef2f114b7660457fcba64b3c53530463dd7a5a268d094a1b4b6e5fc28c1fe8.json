{"nodes": [{"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_context_resolution_engine", "label": "Context Resolution Engine (CRE)", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a71 Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated orchestrator prevents each engine from needing knowledge of the others' states. Without central coordination the context package becomes cluttered, contradictory and unfocused. The CRE resolves context but never creates it, and is prohibited from querying subsystem internals or database tables directly."}, {"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_resolved_context", "label": "Resolved Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a75 Resolved Context", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One immutable, prioritized model of the user's situation, so any downstream consumer (prompt formatter, notification dispatcher, initiative evaluator) reads the same structure."}, {"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_provenance_preservation", "label": "Provenance Preservation", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a711 Architectural Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prioritizing and reconciling must never strip originating metadata (originating subsystem, supporting evidence, confidence rating). Every resolved understanding stays traceable and auditable back to the subsystem that produced it."}, {"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_ai_context_engine", "label": "AI Context Engine (prompt compiler)", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a77 Outputs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept strictly downstream of resolution so prompt formatting and provider communication never absorb context reconciliation logic."}, {"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_conflict_resolution", "label": "Resolve Conflict without Discarding", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a79 Context Resolution Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contradictions between subsystems are included with a note on the conflict rather than thrown out; the state engine (present behavior) acts as tie-breaker and overall confidence is lowered."}, {"id": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_context_relevance_filter", "label": "Context Relevance Filter", "file_type": "concept", "source_file": "docs/GENESIS/architecture/companion-intelligence/08-context-resolution-engine.md", "source_location": "\u00a72 Responsibilities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relevance over quantity: discard low-relevance or redundant detail so prompts stay focused and small."}], "edges": [{"source": "docs_genesis_architecture_companion_intelligence_08_context_resolution_engine_context_resolution_engine", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/archit