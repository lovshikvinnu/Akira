{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_012_reflection_engine_retrospective_reflection_subsystem", "label": "ADR-012: Dedicated Retrospective Reflection Subsystem", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-012-reflection-engine.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected in-conversation reflection (heavy cross-database queries mid-sentence stall the chat) and memory-triggered reflection (recomputing trend lines, skill dependencies and habit stability on every minor write wastes cycles and slows writes). Chosen: asynchronous execution after sessions close, giving zero conversation latency and cached, consistent summaries. Status: Proposed."}, {"id": "docs_genesis_architecture_decisions_adr_012_reflection_engine_consistent_temporal_reference", "label": "Consistent Temporal Reference", "file_type": "rationale", "source_file": "docs/GENESIS/architecture/decisions/ADR-012-reflection-engine.md", "source_location": "Rationale \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrospective intervals are evaluated against a reference supplied by the Companion Platform rather than local device clocks, preventing synchronization drift across devices and preserving chronological sequencing during multi-device use."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_012_reflection_engine_retrospective_reflection_subsystem", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_reflection_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-012-reflection-engine.md", "source_location": "Decision", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_012_reflection_engine_consistent_temporal_reference", "target": "docs_genesis_architecture_decisions_adr_012_reflection_engine_retrospective_reflection_subsystem", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-012-reflection-engine.md", "source_location": "Rationale \u00a75", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_012_reflection_engine_retrospective_reflection_subsystem", "target": "docs_genesis_architecture_companion_intelligence_07_reflection_engine_temporal_decoupling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-012-reflection-engine.md", "source_location": "Rationale \u00a73", "weight": 1.0}], "hyperedges": []}