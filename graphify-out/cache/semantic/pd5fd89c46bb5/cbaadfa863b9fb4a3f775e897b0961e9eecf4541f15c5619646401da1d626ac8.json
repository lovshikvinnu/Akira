{"nodes": [{"id": "docs_recovery_vault_security_data_integrity_recovery_vaultrecovery", "label": "Vault Security and Data Integrity Recovery", "file_type": "document", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": null, "source_url": null, "captured_at": "2026-09-03", "author": null, "contributor": null}, {"id": "docs_recovery_vault_security_data_integrity_recovery_d1_path_traversal", "label": "D1 \u2014 Path Traversal via Prefix Matching", "file_type": "rationale", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/VaultValidationService.ts:28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "resolved.startsWith(root) does not respect path segment boundaries, so any sibling directory whose name merely begins with the Vault root's name escaped the sandbox. The one traversal case the tests covered escaped past the shared prefix and was blocked, hiding the single-level sibling hole."}, {"id": "docs_recovery_vault_security_data_integrity_recovery_d2_soft_delete_dataloss", "label": "D2 \u2014 Soft Delete Destroys a Deduplicated Sibling's Content", "file_type": "rationale", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/VaultStorageService.ts:240-255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Physical file lifetime was decided per record while storage is shared per path, so renaming the file into Trash and updating only the deleted record left every other deduplicated record dangling."}, {"id": "docs_recovery_vault_security_data_integrity_recovery_d3_dedup_against_deleted", "label": "D3 \u2014 Dedup Against Soft-Deleted Records and Hash-Based Cleanup", "file_type": "rationale", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getByHash returned soft-deleted rows, so a new upload could be registered live while pointing at bytes sitting in the bin; and permanentDeleteFile counted references by content hash, which is not the ownership key, both orphaning files forever and appearing to protect bytes it did not describe."}, {"id": "docs_recovery_vault_security_data_integrity_recovery_d0_dead_test_suite", "label": "D0 \u2014 The Entire Vault Test Suite Was Dead", "file_type": "rationale", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/vault.test.ts:29-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four Vault test files declared cases through a local test() helper vitest never saw, and two wrapped each case in try/catch that only console.error-ed failures \u2014 reporting success regardless. Vault regression protection at baseline was zero, and the existing reference-counting case walked straight through the D2 scenario without checking the survivor."}, {"id": "docs_recovery_vault_security_data_integrity_recovery_storage_path_ownership", "label": "Storage Path as the Ownership Key", "file_type": "rationale", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unifying cause of D2 and D3: the code had no single answer to 'who owns these bytes?'. Deduplication created shared ownership while delete, restore and purge each reasoned by a different key (record identity, then content hash) and never by the storage path that actually identifies the bytes."}, {"id": "docs_recovery_vault_security_data_integrity_recovery_vaultvalidationservice", "label": "VaultValidationService", "file_type": "code", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/VaultValidationService.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_vault_security_data_integrity_recovery_vaultstorageservice", "label": "VaultStorageService", "file_type": "code", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/VaultStorageService.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_vault_security_data_integrity_recovery_vaulthashservice", "label": "VaultHashService", "file_type": "code", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/VaultHashService.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_recovery_vault_security_data_integrity_recovery_vaultsecuritytest", "label": "vault-security.test.ts", "file_type": "code", "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "src/akira-os/vault/vault-security.test.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_recovery_phase_a_build_recovery_rc5_stale_test_helpers", "target": "docs_recovery_vault_security_data_integrity_recovery_d0_dead_test_suite", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": null, "weight": 1}, {"source": "docs_recovery_vault_security_data_integrity_recovery_vaultrecovery", "target": "docs_recovery_vault_security_data_integrity_recovery_d1_path_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/recovery/vault-security-data-integrity-recovery.md", "source_location": "\u00a71", "weight": 1}, {"source": "docs_recovery_vault_security_data_integrity_recovery_vaultrecovery", "target