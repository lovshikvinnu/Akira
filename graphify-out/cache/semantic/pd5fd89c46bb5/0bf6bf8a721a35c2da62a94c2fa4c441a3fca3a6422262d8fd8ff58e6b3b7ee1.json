{"nodes": [{"id": "docs_genesis_architecture_decisions_adr_011_habit_intelligence_habit_intelligence_engine", "label": "ADR-011: Evidence-Based Habit Subsystem", "file_type": "document", "source_file": "docs/GENESIS/architecture/decisions/ADR-011-habit-intelligence.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected gamified streaks and scoreboards (a broken streak from a real-world interruption demotivates, prioritizing app engagement over growth) and proactive alert schedulers (intrusive, disrupts deep focus, behaves like a micro-managing boss). The engine observes routines but never enforces them, adapting when the user's schedule changes rather than shaming a broken streak. Status: Proposed."}, {"id": "docs_genesis_architecture_decisions_adr_011_habit_intelligence_habit_context", "label": "Habit Context", "file_type": "concept", "source_file": "docs/GENESIS/architecture/decisions/ADR-011-habit-intelligence.md", "source_location": "Rationale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neutral, evidence-linked pattern model (e.g. a late-evening focus routine verified against recorded work sessions); preserves originating subsystem, supporting evidence and confidence rating. Events represent history while the Habit engine models abstract frequency and probability distributions."}], "edges": [{"source": "docs_genesis_architecture_decisions_adr_011_habit_intelligence_habit_intelligence_engine", "target": "docs_genesis_architecture_decisions_adr_011_habit_intelligence_habit_context", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GENESIS/architecture/decisions/ADR-011-habit-intelligence.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_genesis_architecture_decisions_adr_011_habit_intelligence_habit_intelligence_engine", "target": "docs_genesis_architecture_decis